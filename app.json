{
  "expo": {
    "name": "Sofra · Yazgan",
    "slug": "sofra",
    "scheme": "yazgan-sofra-demo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/sofra-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#234F3B",
        "foregroundImage": "./assets/sofra-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/sofra-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-notifications",
      "expo-web-browser",
      "expo-video",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tarifine kendi yemek fotoğrafını eklemek için fotoğraf seç.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
