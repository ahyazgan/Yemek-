{
  "name": "sofra",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@supabase/supabase-js": "^2.117.3",
    "decode-uri-component": "file:vendor/decode-uri-component-0.5.0-sofra.1.tgz",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "content:check": "tsx scripts/check-content.ts",
    "backend:check": "node scripts/check-live-backend.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run content:check",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:connected": "playwright test --config playwright.connected.config.ts",
    "test:auth": "playwright test --config playwright.connected.config.ts auth-email.spec.ts",
    "export": "expo export --platform all --clear",
    "export:demo": "node scripts/export-demo.mjs",
    "export:preview": "node scripts/export-preview.mjs",
    "release:check": "tsx scripts/check-release.ts",
    "build:android": "node scripts/build-mobile.mjs android",
    "build:ios": "node scripts/build-mobile.mjs ios",
    "build:simulator": "node scripts/build-mobile.mjs simulator",
    "db:seed:generate": "npm run content:check && tsx scripts/generate-seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "node scripts/serve-web.mjs",
    "lint": "expo lint"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
}
