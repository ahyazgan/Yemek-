{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "preview": {
      "android": { "buildType": "apk" },
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_AUTH_MODE": "demo" }
    },
    "preview-connected": {
      "extends": "preview",
      "env": { "EXPO_PUBLIC_AUTH_MODE": "supabase", "EXPO_PUBLIC_HOUSEHOLD_ENABLED": "true" }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": { "simulator": true }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": { "EXPO_PUBLIC_AUTH_MODE": "supabase" }
    }
  }
}
