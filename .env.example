# Default: fully offline demo. Rebuild/restart after changes.
EXPO_PUBLIC_AUTH_MODE=demo
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
EXPO_PUBLIC_COMMUNITY_ENABLED=false
EXPO_PUBLIC_HOUSEHOLD_ENABLED=false
EXPO_PUBLIC_RECIPE_IMPORT_ENABLED=false
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Web production: https://YOUR-DOMAIN
# Native dev build: yazgan-sofra-demo://
# Local web: http://127.0.0.1:8181
EXPO_PUBLIC_AUTH_REDIRECT_BASE=http://127.0.0.1:8181
# Never add service_role, database password, SMTP or market secrets here.

# Optional for local demo, required for the production native EAS profile.
# Choose your own final name, package identifier and scheme; these are public.
SOFRA_APP_NAME=
SOFRA_APP_ID=
SOFRA_APP_SCHEME=
SOFRA_EAS_PROJECT_ID=
